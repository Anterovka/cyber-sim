# Server
SERVER__HOST=0.0.0.0
SERVER__PORT=8000

# Database
DATABASE__URL=postgres://cybersim_user:cybersim_password@localhost:5432/cybersim

# Redis
REDIS__URL=redis://localhost:6379

# JWT
JWT__SECRET=your-secret-key-min-32-chars-long-for-security
JWT__EXPIRATION_HOURS=168

# Certificates
CERTIFICATES__DIR=./certificates

# Logging
RUST_LOG=info,tower_http=debug,axum=debug
